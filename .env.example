# Copy to .env and fill in. .env is gitignored and must NEVER be committed.
# In production these come from a secrets manager / AWS KMS, not a file.

# --- PHI encryption ---
# 32-byte key, base64url-encoded. Generate a dev key with:
#   python -m rcm.core.crypto keygen
# The app REFUSES TO START without this (fail-closed). In prod this is a
# KMS-wrapped data key, not a raw env var.
RCM_MASTER_KEY=

# --- Database ---
# App runtime role: least privilege (no UPDATE/DELETE on audit_log).
RCM_DATABASE_URL=postgresql+psycopg://rcm_app:rcm_app_pw@localhost:5432/rcm
# Migration role: owns schema (used only by alembic).
RCM_MIGRATION_DATABASE_URL=postgresql+psycopg://rcm_migrator:rcm_migrator_pw@localhost:5432/rcm

# --- Anthropic (Claude) ---
# CARC classification uses claude-haiku-4-5; drafting (Phase 1) uses claude-opus-4-8.
# PHI is de-identified before ANY model call (fail-closed). Never log prompt bodies.
ANTHROPIC_API_KEY=

# --- App ---
RCM_ENV=dev
RCM_LOG_LEVEL=INFO
# Embedding provider for public policy docs (LCD/NCD — no PHI).
# "hash" = deterministic offline embedder (dev/test, no downloads).
# Swap to a real provider (sentence-transformers / voyage) in prod.
RCM_EMBEDDING_PROVIDER=hash
RCM_EMBEDDING_DIM=1536
